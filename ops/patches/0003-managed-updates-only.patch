+func TestOpsManagedUpdatesPanelNeverLaunchesUpdater(t *testing.T) {
+	dir := t.TempDir()
+	t.Setenv("XUI_DB_FOLDER", dir)
+	t.Setenv("XUI_MAIN_FOLDER", dir)
+	t.Setenv("XUI_SERVICE", dir)
